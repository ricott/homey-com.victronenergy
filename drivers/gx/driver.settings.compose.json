        ]
    },
    {
        "type": "group",
        "label": {
            "en": "Modbus TCP",
            "sv": "Modbus TCP"
        },
        "children": [
            {
                "id": "modbus_system_unitId",
                "type": "label",
                "label": {
                    "en": "com.victronenergy.system",
                    "sv": "com.victronenergy.system"
                },
                "value": "100"
            },
            {
                "id": "modbus_unitId",
                "type": "number",
                "step": 1,
                "value": -1,
                "label": {
                    "en": "com.victronenergy.vebus",
                    "sv": "com.victronenergy.vebus"
                },
                "hint": {
                    "en": "To see a list of available devices, and their Address, go to Settings -> Services -> Modbus/TCP -> Available services.",
                    "sv": "För att se listan av enheter, gå till Inställningar -> Tjänster -> Modbus/TCP -> Tillgängliga tjänster."
                }
            },
            {
                "id": "timeout",
                "type": "number",
                "value": 5,
                "step": 1,
                "attr": {
                    "min": 1,
                    "max": 60
                },
                "units": {
                    "en": "s"
                },
                "label": {
                    "en": "Modbus timeout (s)",
                    "sv": "Modbus timeout (s)"
                },
                "hint": {
                    "en": "Seconds to wait for a response to each Modbus request before it is treated as failed. Increase (e.g. 10-15) if the device responds slowly.",
                    "sv": "Antal sekunder att vänta på svar på varje Modbus-förfrågan innan den räknas som misslyckad. Öka (t.ex. 10-15) om enheten svarar långsamt."
                }
            }
        ]
    },
    {
        "type": "group",
        "label": {
            "en": "MQTT (for charging schedule actions)",
            "sv": "MQTT (för laddschema)"
        },
        "children": [
            {
                "id": "mqtt_port",
                "type": "number",
                "step": 1,
                "value": 1883,
                "label": {
                    "en": "Port",
                    "sv": "Port"
                },
                "hint": {
                    "en": "MQTT broker port on the GX device. Default is 1883. Enable the broker under Settings -> Services -> MQTT on LAN on the GX.",
                    "sv": "MQTT-portnummer på GX-enheten. Standard är 1883. Aktivera MQTT under Inställningar -> Tjänster -> MQTT on LAN på GX-enheten."
                }
            },
            {
                "id": "mqtt_username",
                "type": "text",
                "value": "",
                "label": {
                    "en": "Username (optional)",
                    "sv": "Användarnamn (valfritt)"
                },
                "hint": {
                    "en": "Only required if you have enabled the Local Security Profile on the GX MQTT broker.",
                    "sv": "Behövs bara om du aktiverat Local Security Profile på GX-enhetens MQTT-broker."
                }
            },
            {
                "id": "mqtt_password",
                "type": "password",
                "value": "",
                "label": {
                    "en": "Password (optional)",
                    "sv": "Lösenord (valfritt)"
                },
                "hint": {
                    "en": "Only required if you have enabled the Local Security Profile on the GX MQTT broker.",
                    "sv": "Behövs bara om du aktiverat Local Security Profile på GX-enhetens MQTT-broker."
                }
            }
        ]
    },

                "id": "port",
                "type": "number",
                "value": 502,
                "step": 1,
                "label": {
                    "en": "Port",
                    "sv": "Port"
                }
            },
            {
                "id": "refreshInterval",
                "type": "number",
                "value": 10,
                "step": 1,
                "attr": {
                    "min": 5,
                    "max": 7200
